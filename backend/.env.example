# Application Environment (development | staging | production)
ENVIRONMENT=development

# Database Configuration
# Local SQLite: sqlite:///./smallbiz.db
# Production PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./smallbiz.db

# Authentication / JWT
# Generate a cryptographically secure key: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes_min
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated, without trailing slashes)
# In production, set to your frontend domain e.g. https://app.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
